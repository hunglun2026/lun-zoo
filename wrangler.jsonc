{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zoo-explorer",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  // 網頁（public/）和 API 同一支 Worker：只有 /api/* 與 /admin/* 先進程式，其他直接回靜態檔
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "zoo-db", "database_id": "8289335c-bd1f-4fc0-a461-8aaedb570410" }
  ],
  // 自訂網域：部署時 Cloudflare 會自動建 DNS 與憑證（hunglun.com 在同一個帳號）
  "routes": [{ "pattern": "zoo.hunglun.com", "custom_domain": true }],
  // 每天台灣 03:00（UTC 19:00）查一次資料集有沒有更新
  "triggers": { "crons": ["0 19 * * *"] },
  "vars": {
    "DATASET_ID": "121197",
    "APP_VERSION": "0.10.3"
  }
  // secrets（wrangler secret put）：NTFY_TOPIC、ADMIN_TOKEN
}
